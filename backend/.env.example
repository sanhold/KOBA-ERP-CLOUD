# ============================================================================
# KOBA ERP CLOUD — ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ============================================================================

# ----------------------------------------------------------------------------
# SERVER & APP CONFIGURATION
# ----------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
APP_NAME="KOBA ERP Cloud Backend"
API_PREFIX=api/v1
CORS_ORIGIN="http://localhost:3000"

# ----------------------------------------------------------------------------
# DATABASE (PostgreSQL + Prisma ORM)
# ----------------------------------------------------------------------------
DATABASE_URL="postgresql://koba_user:koba_password@localhost:5432/koba_erp_db?schema=public&sslmode=prefer"

# ----------------------------------------------------------------------------
# REDIS (Cache, Sessions & Rate Limiting)
# ----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""

# ----------------------------------------------------------------------------
# AUTHENTICATION & SECURITY (JWT)
# ----------------------------------------------------------------------------
JWT_SECRET="koba_super_secret_access_token_key_change_in_production_2026"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="koba_super_secret_refresh_token_key_change_in_production_2026"
JWT_REFRESH_EXPIRES_IN="7d"

# ----------------------------------------------------------------------------
# OBJECT STORAGE / GED (MinIO S3 Compatible)
# ----------------------------------------------------------------------------
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=minio_secret_password
MINIO_BUCKET_NAME=koba-documents
