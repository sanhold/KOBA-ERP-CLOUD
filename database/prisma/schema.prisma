// ============================================================================
// KOBA ERP CLOUD — SCHÉMA DE BASE DE DONNÉES PRISMA (KOBA CORE)
// Reference: docs/DATABASE_ARCHITECTURE.md & docs/DATABASE_ERD.md
// ============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================================
// ENUMS DU SYSTÈME KOBA CORE
// ============================================================================

enum TenantStatus {
  ACTIVE
  SUSPENDED
  PENDING
  ARCHIVED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING_ACTIVATION
  BLOCKED
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ERROR
  WORKFLOW_APPROVAL
}

enum WorkflowActionType {
  APPROVAL
  SIGNATURE
  REVIEW
  NOTIFICATION
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  APPROVE
}

// ============================================================================
// 1. HIERARCHIE ENTERPRISE & MULTI-TENANCY
// ============================================================================

model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @db.VarChar(255)
  slug      String       @unique @db.VarChar(100)
  planType  String       @default("ENTERPRISE") @map("plan_type") @db.VarChar(50)
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?    @map("deleted_at") @db.Timestamptz(6)

  organizations Organizations[]
  companies     Companies[]
  branches      Branches[]
  departments   Departments[]
  users         Users[]
  roles         Roles[]
  settings      Settings[]
  notifications Notifications[]
  documents     Documents[]
  files         Files[]
  workflows     Workflows[]
  auditLogs     AuditLogs[]
  activityLogs  ActivityLogs[]
  sessions      Sessions[]

  @@index([status, deletedAt])
  @@map("tenants")
}

model Organizations {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String    @db.VarChar(255)
  code      String    @db.VarChar(50)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companies Companies[]
  users     Users[]

  @@unique([tenantId, code])
  @@index([tenantId, deletedAt])
  @@map("organizations")
}

model Companies {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  name               String    @db.VarChar(255)
  registrationNumber String?   @map("registration_number") @db.VarChar(100)
  taxId              String?   @map("tax_id") @db.VarChar(100)
  currencyId         String?   @map("currency_id") @db.Uuid
  countryId          String?   @map("country_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organization Organizations @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  country      Countries?    @relation(fields: [countryId], references: [id], onDelete: SetNull)

  branches  Branches[]
  userRoles UserRoles[]
  documents Documents[]
  auditLogs AuditLogs[]
  settings  Settings[]

  @@index([tenantId, organizationId, deletedAt])
  @@map("companies")
}

model Branches {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  name      String    @db.VarChar(255)
  code      String    @db.VarChar(50)
  cityId    String?   @map("city_id") @db.Uuid
  address   String?   @db.Text
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant  Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company Companies @relation(fields: [companyId], references: [id], onDelete: Restrict)
  city    Cities?   @relation(fields: [cityId], references: [id], onDelete: SetNull)

  departments Departments[]
  userRoles   UserRoles[]

  @@unique([companyId, code])
  @@index([tenantId, companyId, deletedAt])
  @@map("branches")
}

model Departments {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  branchId  String    @map("branch_id") @db.Uuid
  name      String    @db.VarChar(255)
  code      String    @db.VarChar(50)
  managerId String?   @map("manager_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branches @relation(fields: [branchId], references: [id], onDelete: Restrict)

  users Users[]

  @@unique([branchId, code])
  @@index([tenantId, branchId, deletedAt])
  @@map("departments")
}

// ============================================================================
// 2. GESTION DES UTILISATEURS & SECURITE (RBAC)
// ============================================================================

model Users {
  id             String     @id @default(uuid()) @db.Uuid
  tenantId       String     @map("tenant_id") @db.Uuid
  organizationId String?    @map("organization_id") @db.Uuid
  departmentId   String?    @map("department_id") @db.Uuid
  email          String     @db.VarChar(255)
  passwordHash   String     @map("password_hash") @db.VarChar(255)
  firstName      String     @map("first_name") @db.VarChar(100)
  lastName       String     @map("last_name") @db.VarChar(100)
  phone          String?    @db.VarChar(50)
  status         UserStatus @default(PENDING_ACTIVATION)
  isMfaEnabled   Boolean    @default(false) @map("is_mfa_enabled")
  mfaSecret      String?    @map("mfa_secret") @db.VarChar(255)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?  @map("deleted_at") @db.Timestamptz(6)

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organization Organizations? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  department   Departments?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  userRoles     UserRoles[]
  sessions      Sessions[]
  notifications Notifications[]
  auditLogs     AuditLogs[]
  activityLogs  ActivityLogs[]

  @@unique([tenantId, email])
  @@index([tenantId, status, deletedAt])
  @@map("users")
}

model Roles {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String?   @map("tenant_id") @db.Uuid
  name        String    @db.VarChar(100)
  code        String    @db.VarChar(100)
  description String?   @db.Text
  isSystem    Boolean   @default(false) @map("is_system")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  rolePermissions RolePermissions[]
  userRoles       UserRoles[]
  workflowSteps   WorkflowSteps[]

  @@unique([tenantId, code])
  @@index([tenantId, deletedAt])
  @@map("roles")
}

model Permissions {
  id          String   @id @default(uuid()) @db.Uuid
  module      String   @db.VarChar(100)
  resource    String   @db.VarChar(100)
  action      String   @db.VarChar(100)
  code        String   @unique @db.VarChar(150)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  rolePermissions RolePermissions[]

  @@map("permissions")
}

model RolePermissions {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Roles       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permissions @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRoles {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  companyId String?  @map("company_id") @db.Uuid
  branchId  String?  @map("branch_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user    Users      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    Roles      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  company Companies? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  branch  Branches?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Sessions {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  refreshTokenHash String   @map("refresh_token_hash") @db.VarChar(255)
  ipAddress        String?  @map("ip_address") @db.VarChar(45)
  userAgent        String?  @map("user_agent") @db.Text
  expiresAt        DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   Users  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, expiresAt])
  @@map("sessions")
}

// ============================================================================
// 3. REFERENTIELS GEOGRAPHIQUES & PARAMETRES
// ============================================================================

model Countries {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  isoCode2  String   @unique @map("iso_code_2") @db.VarChar(2)
  isoCode3  String   @unique @map("iso_code_3") @db.VarChar(3)
  phoneCode String   @map("phone_code") @db.VarChar(10)
  flagUrl   String?  @map("flag_url") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  cities    Cities[]
  companies Companies[]

  @@map("countries")
}

model Cities {
  id         String   @id @default(uuid()) @db.Uuid
  countryId  String   @map("country_id") @db.Uuid
  name       String   @db.VarChar(150)
  regionName String?  @map("region_name") @db.VarChar(150)
  postalCode String?  @map("postal_code") @db.VarChar(20)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  country  Countries  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  branches Branches[]

  @@index([countryId])
  @@map("cities")
}

model Settings {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  companyId   String?  @map("company_id") @db.Uuid
  key         String   @db.VarChar(100)
  value       Json     @db.JsonB
  category    String   @default("GENERAL") @db.VarChar(50)
  isEncrypted Boolean  @default(false) @map("is_encrypted")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company Companies? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@unique([tenantId, key])
  @@map("settings")
}

// ============================================================================
// 4. NOTIFICATIONS, GED (DOCUMENTS) & WORKFLOWS
// ============================================================================

model Notifications {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  title     String           @db.VarChar(255)
  message   String           @db.Text
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false) @map("is_read")
  readAt    DateTime?        @map("read_at") @db.Timestamptz(6)
  payload   Json?            @db.JsonB
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   Users  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, isRead])
  @@map("notifications")
}

model Documents {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  companyId  String    @map("company_id") @db.Uuid
  entityType String    @map("entity_type") @db.VarChar(100)
  entityId   String    @map("entity_id") @db.Uuid
  title      String    @db.VarChar(255)
  createdBy  String    @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant  Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company Companies @relation(fields: [companyId], references: [id], onDelete: Restrict)

  files Files[]

  @@index([tenantId, entityType, entityId, deletedAt])
  @@map("documents")
}

model Files {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  documentId     String   @map("document_id") @db.Uuid
  bucketName     String   @map("bucket_name") @db.VarChar(100)
  objectKey      String   @map("object_key") @db.VarChar(500)
  fileName       String   @map("file_name") @db.VarChar(255)
  fileSize       BigInt   @map("file_size")
  mimeType       String   @map("mime_type") @db.VarChar(100)
  checksumSha256 String?  @map("checksum_sha256") @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document Documents @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([tenantId, documentId])
  @@map("files")
}

model Workflows {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  module      String    @db.VarChar(100)
  processName String    @map("process_name") @db.VarChar(150)
  description String?   @db.Text
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  workflowSteps WorkflowSteps[]

  @@index([tenantId, module, deletedAt])
  @@map("workflows")
}

model WorkflowSteps {
  id             String             @id @default(uuid()) @db.Uuid
  workflowId     String             @map("workflow_id") @db.Uuid
  stepOrder      Int                @map("step_order")
  stepName       String             @map("step_name") @db.VarChar(150)
  requiredRoleId String             @map("required_role_id") @db.Uuid
  actionType     WorkflowActionType @default(APPROVAL) @map("action_type")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workflow     Workflows @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  requiredRole Roles     @relation(fields: [requiredRoleId], references: [id], onDelete: Restrict)

  @@unique([workflowId, stepOrder])
  @@map("workflow_steps")
}

// ============================================================================
// 5. AUDIT & TRACABILITE
// ============================================================================

model AuditLogs {
  id        String      @id @default(uuid()) @db.Uuid
  tenantId  String      @map("tenant_id") @db.Uuid
  companyId String?     @map("company_id") @db.Uuid
  userId    String?     @map("user_id") @db.Uuid
  action    AuditAction
  tableName String      @map("table_name") @db.VarChar(100)
  recordId  String      @map("record_id") @db.Uuid
  oldValues Json?       @map("old_values") @db.JsonB
  newValues Json?       @map("new_values") @db.JsonB
  ipAddress String?     @map("ip_address") @db.VarChar(45)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company Companies? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  user    Users?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, tableName, recordId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

model ActivityLogs {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  eventType   String   @map("event_type") @db.VarChar(100)
  description String   @db.Text
  userAgent   String?  @map("user_agent") @db.Text
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   Users  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, createdAt])
  @@map("activity_logs")
}
